# Copy to .env and fill in your key. NEVER commit the real .env.
GEMINI_API_KEY=your-gemini-api-key-here

# Set to true ONLY if you hit CERTIFICATE_VERIFY_FAILED behind a corporate
# proxy / antivirus that intercepts HTTPS. Skips TLS verification. Leave unset
# (or false) on a clean network.
GEMINI_INSECURE_TLS=false
